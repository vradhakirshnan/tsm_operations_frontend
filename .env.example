# Base API URL for FastAPI backend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Full SSE stream endpoint (defaults to proxy path if not specified)
VITE_SSE_URL=/api/v1/events/kitchen

# Default Kitchen Station ID / Name
VITE_DEFAULT_STATION=Central Kitchen - Main Pod

# Mock Fallback Mode (set to true to use rich mock dataset when backend API is offline)
VITE_ENABLE_MOCK_FALLBACK=true

# Google OAuth 2.0 Client ID for Authentication
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
